{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vs-maxwell.github.io/treasure-valley-grid-stress-sim/schemas/scenario.schema.json",
  "title": "Treasure Valley Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "startYear",
    "endYear",
    "climateScenario",
    "assumptions",
    "truthState"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "startYear": { "type": "integer", "minimum": -15000, "maximum": 2100 },
    "endYear": { "type": "integer", "minimum": -15000, "maximum": 2100 },
    "climateScenario": {
      "enum": ["historical", "baseline", "heat-drought-2050"]
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "truthState": { "$ref": "truth-state.schema.json" }
  }
}
