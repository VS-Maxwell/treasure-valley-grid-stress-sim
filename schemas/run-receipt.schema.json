{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vs-maxwell.github.io/treasure-valley-grid-stress-sim/schemas/run-receipt.schema.json",
  "title": "Treasure Valley Run Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "createdAt",
    "engine",
    "engineVersion",
    "inputSha256",
    "outputSha256",
    "seed",
    "accepted"
  ],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "engine": { "type": "string", "minLength": 1 },
    "engineVersion": { "type": "string", "minLength": 1 },
    "inputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "outputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "seed": { "type": "integer" },
    "accepted": { "type": "boolean" }
  }
}
